# SUPABASE INTEGRATION (Frontend & Vercel / Next.js)
# Get these from your Supabase Project Settings -> API (Project URL & Anon / Public Key)
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# Supabase Service Role Key (Required for server-side programmatic admin user seeding and email confirmation bypass)
SUPABASE_SERVICE_ROLE_KEY=""

# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK INTEGRATION
# Get this from your Paystack Dashboard -> Settings -> API Keys & Webhooks
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"
VITE_PAYSTACK_PUBLIC_KEY="pk_test_your_paystack_public_key"

# EMAIL CONFIRMATION SERVICE (Resend or EmailJS)
# Option A: Resend (Recommended - Server side / Vercel)
# Sign up at https://resend.com and grab your API Key (re_...)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="orders@ajmantech.ng"

# Option B: EmailJS (Client side alternative)
# Get these from your EmailJS Dashboard (https://dashboard.emailjs.com)
VITE_EMAILJS_SERVICE_ID=""
VITE_EMAILJS_TEMPLATE_ID=""
VITE_EMAILJS_PUBLIC_KEY=""
